/*
 * Клиент открывает уже существующий файл, созданный сервером, отображает
 * его себе в память и ждёт появления данных. Когда сервер записывает строку
 * и выставляет флаг готовности, клиент читает строку, выводит на экран
 * и сообщает серверу что данные получены. После этого можно читать ещё
 * или завершить работу.
 */

#include <stdio.h>        // для printf, perror, fgets
#include <stdlib.h>       // для общих нужд
#include <string.h>       // для работы со строками
#include <fcntl.h>        // для open, O_RDWR
#include <unistd.h>       // для close
#include <sys/mman.h>     // для mmap, munmap, msync, MAP_SHARED
#include <sys/stat.h>     // для fstat
#include <sys/select.h>   // для select, fd_set, FD_ZERO, FD_SET
#include <sys/time.h>     // для struct timeval

// Тот же самый файл, что использует сервер
#define FILENAME "/tmp/shared_file.dat"

static int    fd      = -1;   // файловый дескриптор
static char  *ptr     = NULL; // указатель на спроецированную память
// Размер файла сохраняем отдельно, потому что клиент узнаёт его через fstat,
// и он может отличаться от константы FILESIZE, которую использует сервер
static off_t  mapsize = 0;

/*
 * Пункт меню номер 1.
 * Открывает существующий файл, узнаёт его размер и отображает в память.
 * Файл к этому моменту уже должен быть создан сервером.
 */
static void perform_mapping(void)
{
    if (ptr != NULL) {
        printf("[!] Файл уже спроецирован. Сначала завершите работу.\n");
        return;
    }

    /*
     * Открываем файл, который заранее создал сервер.
     * O_RDWR — нужен и на чтение и на запись, потому что клиент
     * не только читает данные, но и пишет флаг "прочитано" обратно.
     */
    fd = open(FILENAME, O_RDWR);
    if (fd == -1) {
        perror("open");
        printf("    Убедитесь, что сервер запущен и выполнил проецирование.\n");
        return;
    }

    /*
     * fstat позволяет узнать размер уже существующего файла.
     * Это важно, потому что клиент не знает заранее, какого размера файл
     * создал сервер (вдруг он не 4096 байт, а другой).
     */
    struct stat st;
    if (fstat(fd, &st) == -1) {
        perror("fstat");
        close(fd);
        fd = -1;
        return;
    }
    mapsize = st.st_size;  // запоминаем реальный размер файла

    /*
     * Отображаем файл в память.
     * Аргументы такие же как у сервера:
     *   NULL — ядро само выберет адрес
     *   mapsize — размер области равен размеру файла
     *   PROT_READ | PROT_WRITE — нужно и читать строку, и писать флаг
     *   MAP_SHARED — чтобы сервер видел наши изменения флага
     *   fd и 0 — какой файл и с какого места отображаем
     */
    ptr = mmap(NULL, mapsize, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
    if (ptr == MAP_FAILED) {
        perror("mmap");
        close(fd);
        fd = -1;
        ptr = NULL;
        return;
    }

    printf("[+] Проецирование выполнено.\n");
    printf("    Файл:    %s\n", FILENAME);
    printf("    Размер:  %ld байт\n", (long)mapsize);
    printf("    Адрес:   %p\n", (void *)ptr);
}

/*
 * Пункт меню номер 2.
 * Ждёт пока сервер запишет данные (флаг станет равен 1), потом читает
 * строку из общей памяти, выводит её и выставляет флаг "прочитано" (2).
 */
static void read_data(void)
{
    if (ptr == NULL) {
        printf("[!] Сначала выполните проецирование (пункт 1).\n");
        return;
    }

    printf("[.] Ожидание данных от сервера");
    fflush(stdout);

    /*
     * Цикл ожидания.
     * В Linux есть особенность: системный вызов select на обычных файлах
     * всегда отвечает "файл готов к чтению", даже если сервер ещё ничего
     * туда не записал. Поэтому нельзя полагаться только на select.
     *
     * Мы используем select просто как таймер (ждём одну секунду),
     * а главную проверку делаем сами — смотрим на значение ptr[0].
     * Как только сервер поставит туда 1, цикл прерывается.
     */
    while (ptr[0] != 1) {
        fd_set read_fds;           // набор дескрипторов для select
        struct timeval timeout;    // структура с таймаутом

        FD_ZERO(&read_fds);        // очищаем набор
        FD_SET(fd, &read_fds);     // добавляем наш файловый дескриптор
        timeout.tv_sec  = 1;       // ждём максимум 1 секунду
        timeout.tv_usec = 0;       // и 0 микросекунд

        // select вернёт управление либо когда файл станет "готов к чтению"
        // (что происходит сразу), либо через 1 секунду по таймауту
        int result = select(fd + 1, &read_fds, NULL, NULL, &timeout);
        if (result == -1) {
            perror("select");
            return;
        }

        // Печатаем точку, чтобы пользователь видел что программа не зависла
        printf(".");
        fflush(stdout);
    }
    printf("\n");

    /*
     * Сервер записывает строку начиная с ptr[1], пропуская флаг.
     * Поэтому читаем оттуда же. Строка уже заканчивается нулевым байтом,
     * поэтому printf с форматом %s выведет её целиком.
     */
    printf("[+] Получены данные: %s\n", ptr + 1);

    /*
     * Выставляем флаг в 2 — "данные прочитаны".
     * Сервер в это время крутится в своём цикле и ждёт именно этого значения.
     * После того как он увидит 2, он вернётся в меню.
     */
    ptr[0] = 2;
    // Сбрасываем изменения в файл, чтобы сервер точно увидел новое значение флага
    msync(ptr, mapsize, MS_SYNC);
}

/*
 * Пункт меню номер 3.
 * Отменяет отображение памяти и закрывает файл.
 * В отличие от сервера, клиент не удаляет файл — это делает сервер
 * при своём завершении.
 */
static void finish_work(void)
{
    // Отменяем отображение памяти
    if (ptr != NULL) {
        if (munmap(ptr, mapsize) == -1)
            perror("munmap");
        ptr = NULL;
    }

    // Закрываем файловый дескриптор
    if (fd != -1) {
        close(fd);
        fd = -1;
    }

    printf("[+] Клиент завершил работу.\n");
}

/*
 * Главная функция клиента. Показывает меню и обрабатывает выбор.
 * Всё точно так же как у сервера, только пункты меню другие.
 */
int main(void)
{
    int choice;
    char line[32];

    printf(" КЛИЕНТ (читатель) \n");

    while (1) {
        printf("\n Меню клиента \n");
        printf("1) Выполнить проецирование\n");
        printf("2) Прочитать данные\n");
        printf("3) Завершить работу\n");
        printf("Ваш выбор: ");

        if (fgets(line, sizeof(line), stdin) == NULL)
            break;

        if (sscanf(line, "%d", &choice) != 1) {
            printf("[!] Введите число 1, 2 или 3.\n");
            continue;
        }

        switch (choice) {
            case 1: perform_mapping(); break;
            case 2: read_data();       break;
            case 3: finish_work();     return 0;
            default: printf("[!] Неверный пункт меню.\n");
        }
    }

    finish_work();
    return 0;
}
