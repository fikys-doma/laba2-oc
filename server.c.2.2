/*
 * Эта программа создаёт файл в /tmp, отображает его в оперативную память
 * через системный вызов mmap, записывает туда строку, введённую с клавиатуры,
 * и ждёт пока клиент её прочитает. Потом можно записать новую строку или выйти.
 * При выходе сервер удаляет файл за собой.
 */

#include <stdio.h>      // для printf, perror, fgets, sprintf
#include <stdlib.h>     // для общих нужд
#include <string.h>     // для memset, strcspn
#include <fcntl.h>      // для open, O_RDWR, O_CREAT, O_TRUNC
#include <unistd.h>     // для ftruncate, sleep, close, unlink
#include <sys/mman.h>   // для mmap, munmap, msync, MAP_SHARED
#include <sys/stat.h>   // для прав доступа S_IRUSR и остальных

// Файл будет лежать в папке /tmp, она доступна всем процессам в системе
#define FILENAME "/tmp/shared_file.dat"
// Размер файла — 4096 байт, стандартный размер одной страницы памяти
#define FILESIZE 4096

/*
 * Договорённость между сервером и клиентом о том, как устроена общая память:
 * Первый байт (ptr[0]) — это флаг состояния.
 *   Если там 0 — данных нет, можно писать.
 *   Если там 1 — сервер только что записал данные, клиент может читать.
 *   Если там 2 — клиент прочитал данные, сервер может писать снова.
 * Все остальные байты начиная с ptr[1] — это сама строка,
 * которую передаёт сервер клиенту. Строка заканчивается нулевым байтом.
 */

// Эти переменные живут всё время работы программы
static int   fd  = -1;   // файловый дескриптор, через него работаем с файлом
static char *ptr = NULL; // указатель на начало спроецированной области памяти

/*
 * Пункт меню номер 1.
 * Создаёт файл на диске и отображает его в адресное пространство процесса.
 * После вызова этой функции можно писать в ptr как в обычный массив,
 * а изменения автоматически попадут в файл и станут видны клиенту.
 */
static void perform_mapping(void)
{
    // Защита от повторного вызова: если ptr уже не NULL, значит
    // мы уже проецировали файл и второй раз этого делать не надо
    if (ptr != NULL) {
        printf("[!] Файл уже спроецирован. Сначала завершите работу.\n");
        return;
    }

    /*
     * Открываем (или создаём) файл.
     * O_RDWR — открываем для чтения и записи.
     * O_CREAT — если файла нет, он будет создан.
     * O_TRUNC — если файл уже был, его содержимое обнуляется.
     * S_IRUSR | S_IWUSR | S_IRGRP | S_IROTH — права доступа: владелец может
     * читать и писать, остальные только читать.
     */
    fd = open(FILENAME, O_RDWR | O_CREAT | O_TRUNC,
              S_IRUSR | S_IWUSR | S_IRGRP | S_IROTH);
    if (fd == -1) {
        perror("open");
        return;
    }

    /*
     * ftruncate устанавливает размер файла ровно в FILESIZE байт.
     * Это обязательно нужно сделать, потому что если файл только создан,
     * его размер равен нулю, и mmap откажется с ним работать.
     */
    if (ftruncate(fd, FILESIZE) == -1) {
        perror("ftruncate");
        close(fd);
        fd = -1;
        return;
    }

    /*
     * Главный системный вызов — mmap.
     * Он отображает содержимое файла в оперативную память процесса.
     * Аргументы:
     *   NULL  — ядро само выберет адрес в виртуальной памяти
     *   FILESIZE — сколько байт файла отображаем
     *   PROT_READ | PROT_WRITE — разрешаем чтение и запись
     *   MAP_SHARED — изменения будут видны другим процессам
     *   fd — какой файл отображаем
     *   0 — начинаем с самого начала файла
     */
    ptr = mmap(NULL, FILESIZE, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
    if (ptr == MAP_FAILED) {
        perror("mmap");
        close(fd);
        fd = -1;
        ptr = NULL;
        return;
    }

    // Зануляем всю выделенную область.
    // Это нужно чтобы флаг точно был 0 и в строке не было мусора.
    memset(ptr, 0, FILESIZE);
    // msync сбрасывает изменения из памяти обратно в файл на диске.
    // Это гарантирует, что даже если клиент откроет файл прямо сейчас,
    // он увидит нули, а не случайные данные.
    msync(ptr, FILESIZE, MS_SYNC);

    printf("[+] Проецирование выполнено.\n");
    printf("    Файл:    %s\n", FILENAME);
    printf("    Размер:  %d байт\n", FILESIZE);
    printf("    Адрес:   %p\n", (void *)ptr);
}

/*
 * Пункт меню номер 2.
 * Запрашивает у пользователя строку, записывает её в общую память,
 * выставляет флаг "данные готовы" и ждёт пока клиент не прочитает.
 * Только после этого возвращается в главное меню.
 */
static void write_data(void)
{
    // Если проецирование ещё не делали, писать некуда
    if (ptr == NULL) {
        printf("[!] Сначала выполните проецирование (пункт 1).\n");
        return;
    }

    // Буфер для строки. Отводим FILESIZE минус 2 байта:
    // один байт занимает флаг в начале, ещё один байт нужен под символ
    // конца строки, который добавит sprintf.
    char buffer[FILESIZE - 2];

    printf("Введите строку для записи: ");
    if (fgets(buffer, sizeof(buffer), stdin) == NULL) {
        printf("[!] Ошибка ввода строки.\n");
        return;
    }

    // fgets сохраняет символ перевода строки \n в конце, если он был.
    // Нам он не нужен, поэтому находим его и заменяем на нулевой байт.
    buffer[strcspn(buffer, "\n")] = '\0';

    // Копируем строку в общую память начиная со второго байта.
    // ptr + 1 сдвигает указатель на один байт вперёд, пропуская флаг.
    sprintf(ptr + 1, "%s", buffer);

    // Выставляем флаг в 1. Это сигнал клиенту: "можно читать".
    ptr[0] = 1;

    // Обязательно сбрасываем изменения в файл, чтобы клиент их увидел.
    msync(ptr, FILESIZE, MS_SYNC);

    printf("[+] Записано в общую память: \"%s\"\n", buffer);
    printf("[.] Ожидание чтения клиентом");
    fflush(stdout);  // выводим текст сразу, не дожидаясь перевода строки

    /*
     * Цикл ожидания клиента.
     * Проверяем ptr[0] примерно раз в секунду. Как только клиент
     * выставит там значение 2, цикл завершится.
     * sleep(1) даёт паузу в одну секунду между проверками, чтобы
     * не нагружать процессор постоянным чтением памяти.
     */
    while (ptr[0] != 2) {
        printf(".");
        fflush(stdout);  // печатаем точку сразу, чтобы было видно что ждём
        sleep(1);
    }
    printf("\n[+] Клиент прочитал данные.\n");

    // Возвращаем флаг в 0, чтобы можно было записать новую строку.
    ptr[0] = 0;
    msync(ptr, FILESIZE, MS_SYNC);
}

/*
 * Пункт меню номер 3.
 * Аккуратно завершает работу: отменяет отображение памяти,
 * закрывает файл и удаляет его с диска.
 */
static void finish_work(void)
{
    // munmap отменяет отображение — память больше не связана с файлом
    if (ptr != NULL) {
        if (munmap(ptr, FILESIZE) == -1)
            perror("munmap");
        ptr = NULL;
    }

    // Закрываем файловый дескриптор
    if (fd != -1) {
        close(fd);
        fd = -1;
    }

    // unlink удаляет файл с диска. Клиенту он больше не понадобится,
    // потому что сервер уже всё записал и завершает работу.
    if (unlink(FILENAME) == -1)
        perror("unlink");
    else
        printf("[+] Файл %s удалён.\n", FILENAME);

    printf("[+] Сервер завершил работу.\n");
}

/*
 * Главная функция. Показывает меню из трёх пунктов и обрабатывает
 * выбор пользователя в бесконечном цикле, пока не выберут пункт 3.
 */
int main(void)
{
    int choice;
    char line[32];

    printf(" СЕРВЕР (писатель) \n");

    while (1) {
        printf("\n Меню сервера \n");
        printf("1) Выполнить проецирование\n");
        printf("2) Записать данные\n");
        printf("3) Завершить работу\n");
        printf("Ваш выбор: ");

        // Читаем строку с клавиатуры
        if (fgets(line, sizeof(line), stdin) == NULL)
            break;

        // Пробуем распарсить число из строки
        if (sscanf(line, "%d", &choice) != 1) {
            printf("[!] Введите число 1, 2 или 3.\n");
            continue;
        }

        switch (choice) {
            case 1: perform_mapping(); break;
            case 2: write_data();      break;
            case 3: finish_work();     return 0;
            default: printf("[!] Неверный пункт меню.\n");
        }
    }

    // Если цикл прервался (например, конец файла при вводе),
    // всё равно корректно завершаем работу
    finish_work();
    return 0;
}
